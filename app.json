{
  "expo": {
    "name": "Matebeto",
    "slug": "matebeto-team",
    "owner": "matebetos-team",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "matebeto",
    "platforms": ["ios", "android"],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "androidStatusBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.siximages.matebeto",
      "buildNumber": "3"
    },
    "android": {
      "package": "com.siximages.matebeto",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4A300"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F4A300"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Matebeto to pick food photos from your phone.",
          "cameraPermission": "Allow Matebeto to take food photos for markets, meals and categories."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "70c2c6ad-a0e0-4a4b-8f69-136bcb7e001a"
      }
    }
  }
}
