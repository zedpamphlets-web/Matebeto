{
  "expo": {
    "name": "Matebeto",
    "slug": "matebeto2027",
    "owner": "matebeto2027s-team",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "matebeto",
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "androidStatusBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.siximages.matebeto",
      "buildNumber": "6"
    },
    "android": {
      "package": "com.siximages.matebeto",
      "versionCode": 6,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "compileSdkVersion": 35,
            "targetSdkVersion": 34,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F4A300"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Matebeto to pick food and licence photos from your phone.",
          "cameraPermission": "Allow Matebeto to take food, licence and rider photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Matebeto to capture your rider photo inside the app.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6c62308d-1842-493e-a0e2-360ba6662c98"
      },
      "supabaseUrl": "https://lmyvvwulabezlglxjzvl.supabase.co",
      "supabaseAnonKey": "sb_publishable_XJVKUkLgF-0OJk2Mf4N8nQ_ZhmtezXu",
      "supabasePublishableKey": "sb_publishable_XJVKUkLgF-0OJk2Mf4N8nQ_ZhmtezXu",
      "paymentApiUrl": "https://lmyvvwulabezlglxjzvl.supabase.co/functions/v1"
    }
  }
}