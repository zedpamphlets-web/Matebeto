{
  "expo": {
    "name": "Matebeto",
    "slug": "mwape-victor2007",
    "owner": "matebeto2026s-team",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "matebeto",
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "androidStatusBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.siximages.matebeto",
      "buildNumber": "5"
    },
    "android": {
      "package": "com.siximages.matebeto",
      "versionCode": 5,
      "permissions": ["INTERNET", "ACCESS_NETWORK_STATE"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4A300"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F4A300"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Matebeto to pick food and licence photos from your phone.",
          "cameraPermission": "Allow Matebeto to take food, licence and rider photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Matebeto to capture your rider photo inside the app.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a8e8cd91-6e9b-4b06-abdc-1b1729724099"
      },
      "supabaseUrl": "https://lmyvvwulabezlglxjzul.supabase.co",
      "supabaseAnonKey": "sb_publishable_XJVKUkLgF-0OJk2Mf4N8nQ_ZhmtezXu",
      "supabasePublishableKey": "sb_publishable_XJVKUkLgF-0OJk2Mf4N8nQ_ZhmtezXu",
      "paymentApiUrl": "https://lmyvvwulabezlglxjzul.supabase.co/functions/v1"
    }
  }
}
